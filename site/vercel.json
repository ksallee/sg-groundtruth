{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "sveltekit",

  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },

  "ignoreCommand": "bash -c 'if [ \"$VERCEL_GIT_COMMIT_REF\" = \"prod\" ]; then exit 1; else exit 0; fi'"
}
