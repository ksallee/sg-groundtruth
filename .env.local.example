FPT_API_SITE_URL=https://yoursite.shotgrid.autodesk.com
FPT_API_SCRIPT_NAME=
FPT_API_API_KEY=

# Probe targets. Site ids and names are site data — neither belongs in committed source.
# Projects a probe may READ and measure, most interesting first. Names or ids, mixed freely.
FPT_PROBE_SAMPLE_PROJECTS=Some Busy Show, 91
# The one project a probe may WRITE into. A name: probe 011 creates it if absent.
FPT_PROBE_SANDBOX_PROJECT=probe sandbox
# Probe 022 only: a directory holding a .png frame sequence and a .mov of the same shot.
FPT_PROBE_FRAMES_DIR=
